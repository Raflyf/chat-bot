# ==============================================================================
# TEMPLATE KONFIGURASI LINGKUNGAN (.env.example)
# Salin ke `.env` lalu isi nilainya. Urutan seksi mengikuti rantai failover 6 TIER:
#   OpenCode > Cloudflare > Groq > DreamPrompting > OpenRouter > Gemini.
# Nama model dikelola di kode (src/env.ts) — di sini hanya kredensial & batas kuota.

# ==============================================================================
# ==============================================================================
# 1. TELEGRAM BOT & OWNER
# ==============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=

# ── GRUP TELEGRAM (opsional) ──
# Bot BOLEH dipakai di grup, tetapi TIDAK PERNAH menyahut sendiri. Di grup bot
# hanya menjawab bila DIPANGGIL:
#   1) tulis pertanyaannya lalu panggil `/namabot` — mis. "harga emas berapa /chatkita_bot"
#      (nama bot mengikuti TELEGRAM_BOT_USERNAME di atas)
#   2) tag @namabot
#   3) reply (balas) pesan bot
# Cara 1 sengaja dibuat seperti memanggil Meta AI di X: pertanyaan ditulis dulu,
# lalu bot dipanggil. Kata panggilnya otomatis dibuang dari pertanyaan.
#
# Daftar putih grup (opsional, dipisah koma). Bila DIISI, bot HANYA melayani grup
# yang terdaftar. Kosong = semua grup boleh (tetap wajib dipanggil dulu).
# Isi dengan id grup, mis.: TELEGRAM_GROUP_ALLOWLIST=-1001234567890,-1009876543210
TELEGRAM_GROUP_ALLOWLIST=

# ==============================================================================
# ==============================================================================
# 2. WHATSAPP (META CLOUD API - OBROLAN PRIBADI 1-ON-1)
# ==============================================================================
# Catatan: Layanan WhatsApp produksi menggunakan Meta Cloud API via Vercel Serverless (khusus chat pribadi 1-on-1).
# Modul Baileys & opsi grup belum diimplementasikan di lingkungan produksi karena ketiadaan VPS.
WHATSAPP_PHONE_NUMBER=
OWNER_WA_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Mode pemeliharaan WhatsApp (sementara). NONAKTIF secara default.
# Set `true` bila pengiriman WhatsApp Cloud API sedang terblokir Meta
# (mis. payment method belum tertaut -> error 141006 "payment method error").
# Saat aktif: bot TIDAK memanggil AI untuk pesan WhatsApp (hemat kuota) dan
# hanya mengirim pemberitahuan pemeliharaan + mengarahkan pengguna ke Telegram.
# Set kembali `false` (atau hapus) setelah payment method beres.
WHATSAPP_MAINTENANCE_MODE=false

# ==============================================================================
# ==============================================================================
# 3. DATABASE SUPABASE
# ==============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ==============================================================================
# ==============================================================================
# 4. BOT IDENTITY & RUNTIME CONFIG
# ==============================================================================
BOT_NAME=FreeAIBot
BOT_PROFILE=Asisten AI umum berbahasa Indonesia. Cerdas, adaptif, solutif, dan berwawasan luas. Jawab pertanyaan apa pun dengan benar, informatif, dan terstruktur rapi.
# Timeout koneksi awal (fase-1 singkat: model harus segera merespons atau difailover)
CONNECT_TIMEOUT_MS=3000
# Pagar total seluruh rantai failover per request (pengaman serverless Vercel)
CHAIN_DEADLINE_MS=45000
# Batas waktu token pertama untuk request teks (fase-1: failover gesit bila model menggantung)
FIRST_TOKEN_TIMEOUT_MS=4000
# Batas waktu antar-chunk saat model SUDAH merespons (fase-2: beri ruang model reasoning menyusun jawaban)
STREAM_IDLE_TIMEOUT_MS=30000
# Batas waktu token pertama khusus request berisi gambar/vision (upload base64 butuh waktu lebih lama)
VISION_FIRST_TOKEN_MS=12000
# Timeout koneksi khusus request berisi gambar/vision
VISION_CONNECT_TIMEOUT_MS=8000
# Pagar waktu request non-streaming (jalur khusus seperti PDF)
REQUEST_TIMEOUT_MS=90000
MAX_OUTPUT_TOKENS=2500
# Batas total token konteks prompt per request (trim otomatis; jaga di bawah TPM provider ketat)
MAX_TOKENS_LIMIT=8000
# Ambang "model lambat" (ms): model yang rata-rata merespons lebih lambat dari ini
# diturunkan prioritasnya di dalam tier yang sama (failover berbasis waktu respons).
SLOW_MODEL_MS=12000
DOWNLOAD_TIMEOUT_MS=30000
CACHE_TTL_MS=3600000
# Set 1 untuk log format human-readable (default: JSON single-line)
LOG_PRETTY=0

# ==============================================================================
# ==============================================================================
# TIER 1: OPENCODE FREE (DeepSeek V4.1 Flash / GLM 5.3 Flash)
# public adalah penanda noAuth, bukan API key.
OPENCODE_KEYS=public
DAILY_CAP_OPENCODE=1000
DAILY_TOKEN_CAP_OPENCODE=0

# TIER 2: CLOUDFLARE (Qwen 3.8 / Nemotron; model vision terpisah)
# Format accountId:token, dipisah koma. Batas harian dalam NEURON, bukan token.
CLOUDFLARE_KEYS=
CLOUDFLARE_ACCOUNT_ID=
DAILY_CAP_CLOUDFLARE=120
DAILY_TOKEN_CAP_CLOUDFLARE=10000

# TIER 3: GROQ (Qwen 3.8 / GPT-OSS 120B; Whisper untuk audio)
GROQ_KEYS=
DAILY_CAP_GROQ=1000
DAILY_TOKEN_CAP_GROQ=200000

# TIER 4: DREAMPROMPTING (Qwen 3.8 saja)
DREAMPROMPTING_KEYS=
DAILY_CAP_DREAMPROMPTING=1000
DAILY_TOKEN_CAP_DREAMPROMPTING=500000

# TIER 5: OPENROUTER (Nemotron 3.5 Super VL / Nemotron 3 Ultra)
OPENROUTER_KEYS=
DAILY_CAP_OPENROUTER=50
DAILY_TOKEN_CAP_OPENROUTER=0

# TIER 6: GEMINI (2.5 Flash / Flash Lite Latest; gambar/audio/PDF/video)
GEMINI_KEYS=
DAILY_CAP_GEMINI=1500
DAILY_TOKEN_CAP_GEMINI=0

# RACE teks dalam tier; cadangan menyusul setelah 400 ms.
RACE_MODELS=1
RACE_STAGGER_MS=400

# ADMIN AUTH
RESEND_API_KEY=
RESEND_FROM=ChatBot Security <notifications@resend.dev>
ADMIN_EMAIL=
PIN_SALT=
ADMIN_PIN=

