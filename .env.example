# JANGAN commit file ini dengan key asli. Salin ke .env lalu isi.
# Semua key di bawah ini placeholder kosong.

# Wajib P0
TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=

# Pool key provider (comma-separated, tanpa spasi). Rotasi otomatis, stop saat 429/kuota.
OPENROUTER_KEYS=
GROQ_KEYS=
GEMINI_KEYS=
OLLAMA_KEYS=

# Model override (opsional, default = hasil verifikasi live PRD v0.2)
OR_MODEL_PRIMARY=nex-agi/nex-n2.5-pro:free
OR_MODEL_MINI=nex-agi/nex-n2.5-mini:free
OR_MODEL_TEXT=nvidia/nemotron-3.5-lightning:free
GROQ_MODEL_PRIMARY=qwen/qwen3.8-27b
GROQ_MODEL_BACKUP=qwen/qwen3.6-27b
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_BACKUP=gemini-2.5-flash
OLLAMA_MODEL_PRIMARY=nemotron-3-nano:30b
OLLAMA_MODEL_BACKUP=gpt-oss:20b

# Opsional
SUPABASE_URL=
SUPABASE_ANON_KEY=
SHOP_NAME=Toko Contoh
SHOP_PROFILE=Toko kelontong online, jam 08.00-21.00 WIB. Jawab singkat Bahasa Indonesia yang ramah.
REQUEST_TIMEOUT_MS=15000
CACHE_TTL_MS=3600000
DAILY_CAP_OPENROUTER=180
DAILY_CAP_GROQ=800
DAILY_CAP_GEMINI=1400
DAILY_CAP_OLLAMA=500
