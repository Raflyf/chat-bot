# ==============================================================================
# TEMPLATE KONFIGURASI LINGKUNGAN (.env.example)
# Salin ke `.env` lalu isi nilainya. Urutan seksi mengikuti rantai failover 7 TIER:
#   T1 DreamPrompting > T2 Cloudflare > T3 OpenCode > T4 OpenRouter > T5 NIM
#   > T6 Groq > T7 Gemini > T8 Dahl.
# Nama model dikelola di kode (src/env.ts) — di sini hanya kredensial & batas kuota.

# ==============================================================================
# ==============================================================================
# 1. TELEGRAM BOT & OWNER
# ==============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=

# ==============================================================================
# ==============================================================================
# 2. WHATSAPP (META CLOUD API - OBROLAN PRIBADI 1-ON-1)
# ==============================================================================
# Catatan: Layanan WhatsApp produksi menggunakan Meta Cloud API via Vercel Serverless (khusus chat pribadi 1-on-1).
# Modul Baileys & opsi grup belum diimplementasikan di lingkungan produksi karena ketiadaan VPS.
WHATSAPP_PHONE_NUMBER=
OWNER_WA_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ==============================================================================
# ==============================================================================
# 3. DATABASE SUPABASE
# ==============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ==============================================================================
# ==============================================================================
# 4. BOT IDENTITY & RUNTIME CONFIG
# ==============================================================================
BOT_NAME=FreeAIBot
BOT_PROFILE=Asisten AI umum berbahasa Indonesia. Cerdas, adaptif, solutif, dan berwawasan luas. Jawab pertanyaan apa pun dengan benar, informatif, dan terstruktur rapi.
# Timeout koneksi awal (fase-1 singkat: model harus segera merespons atau difailover)
CONNECT_TIMEOUT_MS=3000
# Pagar total seluruh rantai failover per request (pengaman serverless Vercel)
CHAIN_DEADLINE_MS=45000
# Batas waktu token pertama untuk request teks (fase-1: failover gesit bila model menggantung)
FIRST_TOKEN_TIMEOUT_MS=4000
# Batas waktu antar-chunk saat model SUDAH merespons (fase-2: beri ruang model reasoning menyusun jawaban)
STREAM_IDLE_TIMEOUT_MS=30000
# Batas waktu token pertama khusus request berisi gambar/vision (upload base64 butuh waktu lebih lama)
VISION_FIRST_TOKEN_MS=12000
# Timeout koneksi khusus request berisi gambar/vision
VISION_CONNECT_TIMEOUT_MS=8000
# Pagar waktu request non-streaming (jalur khusus seperti Dahl/PDF)
REQUEST_TIMEOUT_MS=90000
MAX_OUTPUT_TOKENS=2500
# Batas total token konteks prompt per request (trim otomatis; jaga di bawah TPM provider ketat)
MAX_TOKENS_LIMIT=8000
# Ambang "model lambat" (ms): model yang rata-rata merespons lebih lambat dari ini
# diturunkan prioritasnya di dalam tier yang sama (failover berbasis waktu respons).
SLOW_MODEL_MS=12000
DOWNLOAD_TIMEOUT_MS=30000
CACHE_TTL_MS=3600000
# Set 1 untuk log format human-readable (default: JSON single-line)
LOG_PRETTY=0

# ==============================================================================
# ==============================================================================
# 5. PROVIDER TIER 1: DREAMPROMPTING (GROQ/QWEN 3.6 27B & GROQ/GPT-OSS 120B)
# ==============================================================================
# BATAS NYATA (terverifikasi dari pesan 429 endpoint, 04 Okt):
#   500.000 token / rolling 24 jam — DIJUMLAH semua key pada satu akun.
#   Bukan RPD, bukan reset tengah malam. Endpoint kuota (/v1/usage dll) = 404 HTML.
DREAMPROMPTING_KEYS=
# Cap request sebagai pengaman internal; batas sebenarnya = token.
DAILY_CAP_DREAMPROMPTING=1000
# Batas token per rolling 24 jam (dijumlah semua key akun) — sesuai endpoint.
DAILY_TOKEN_CAP_DREAMPROMPTING=500000

# ==============================================================================
# ==============================================================================
# 6. PROVIDER TIER 2: CLOUDFLARE WORKERS AI (QWEN 3.8 27B, NEMOTRON 3, GPT-OSS 20B, VISION)
# ==============================================================================
# Format: accountId:token atau token bare (dipisah koma)
CLOUDFLARE_KEYS=
CLOUDFLARE_ACCOUNT_ID=
DAILY_CAP_CLOUDFLARE=120
# Batas token per hari per key (0 = tidak dibatasi)
DAILY_CAP_CLOUDFLARE=120
# BATAS NYATA = NEURON (bukan request): 10.000 neuron/akun/hari (Free Tier resmi).
# Cloudflare tidak mengekspos sisa neuron lewat API, dan neuron ≈ token untuk LLM,
# jadi pemakaian token dipakai sebagai PROXY. Tanpa angka ini (0 = tanpa batas),
# dashboard akan salah menampilkan "OPTIMAL" padahal neuron sudah habis (kasus 04 Okt).
DAILY_TOKEN_CAP_CLOUDFLARE=10000


# ==============================================================================
# PROVIDER TIER 3: OPENCODE FREE (mimo-v2.6-flash-free + muse-spark-1.3-contributor-free)
# ==============================================================================
# TANPA API KEY (noAuth) — endpoint memakai Authorization: "Bearer public".
# Nilai "public" hanya penanda agar loop tier berjalan; bukan kredensial.
#
# Rahasia akses (dibedah dari repo 9router open-sse/executors/opencode.js):
#   1. WAJIB memuat 4 tool fingerprint: bash, glob, grep, read
#      (tanpa ini -> 403 "free tier can only be used from within OpenCode")
#   2. Format beda per endpoint: muse-spark -> /responses (tool flat),
#      model lain -> /chat/completions (tool nested)
#   3. Session stabil (kuota dihitung per sesi, bukan per akun)
#   4. Wajib streaming
#
# TANPA batas token per chat di sisi bot — batas 8.000 token/respons
# sudah ditegakkan endpoint OpenCode sendiri.
OPENCODE_KEYS=public
DAILY_CAP_OPENCODE=1000
DAILY_TOKEN_CAP_OPENCODE=0
# ==============================================================================
# ==============================================================================
# 7. PROVIDER TIER 3: NVIDIA NIM (DIFFUSION GEMMA 26B & LLAMA 3.2 11B VISION)
# ==============================================================================
NVIDIA_KEYS=
DAILY_CAP_NVIDIA=1000
DAILY_TOKEN_CAP_NVIDIA=0

# ==============================================================================
# ==============================================================================
# 8. PROVIDER TIER 4: OPENROUTER AI (NEMOTRON 3 ULTRA 550B FREE, LING 3.0 FLASH SANTE FREE)
# ==============================================================================
OPENROUTER_KEYS=
DAILY_CAP_OPENROUTER=50
# Batas token per hari per key (0 = tidak dibatasi)
DAILY_TOKEN_CAP_OPENROUTER=0

# ==============================================================================
# ==============================================================================
# 9. PROVIDER TIER 5: GROQ CLOUD API (QWEN 3.8 27B, GPT-OSS 120B, WHISPER)
# ==============================================================================
# Free Tier resmi per key: 1.000 RPD, 30 RPM, 8K TPM, 200K TPD (qwen3.8/3.6-27b)
# TPD biasanya tercapai lebih dulu daripada RPD, jadi keduanya dibatasi runtime.
GROQ_KEYS=
DAILY_CAP_GROQ=1000
DAILY_TOKEN_CAP_GROQ=200000

# ==============================================================================
# ==============================================================================
# 10. PROVIDER TIER 6: GOOGLE GEMINI API (MULTIMODAL, PDF & VIDEO NATIVE)
# ==============================================================================
# Free Tier resmi: 1.500 RPD/key, 1M TPM (bebas kuota token harian)
GEMINI_KEYS=
DAILY_CAP_GEMINI=1500
# Batas token per hari per key (0 = tidak dibatasi; Gemini free tier bebas kuota token)
DAILY_TOKEN_CAP_GEMINI=0

# ==============================================================================
# ==============================================================================
# 11. PROVIDER TIER 7: DAHL GLOBAL API (DEEPSEEK V4 FLASH & GLM 5.3 FLASH)
# ==============================================================================
DAHL_KEYS=
DAHL_BASE_URL=https://inference.dahl.global/v1
# Opsional: proxy Cloudflare Worker untuk bypass WAF Dahl (kosongkan untuk endpoint langsung)
DAHL_PROXY_URL=
DAILY_CAP_DAHL=5000
# Batas token per hari per key (0 = tidak dibatasi)
DAILY_TOKEN_CAP_DAHL=0

# ==============================================================================
# ==============================================================================
# 12. PROVIDER CADANGAN & SEARCH: XKIRO GATEWAY
# ==============================================================================
XKIRO_KEYS=
DAILY_CAP_XKIRO=500
DAILY_TOKEN_CAP_XKIRO=500000
DAILY_TOKEN_CAP_PER_KEY_XKIRO=1000000,1000000,500000,500000,500000,500000,500000,500000

# ==============================================================================
# ==============================================================================
# 11. ADMIN AUTH & SECURITY
# ==============================================================================
RESEND_API_KEY=
RESEND_FROM=ChatBot Security <onboarding@resend.dev>
ADMIN_EMAIL=
PIN_SALT=
ADMIN_PIN=
