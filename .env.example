# JANGAN commit file ini dengan key asli. Salin ke .env lalu isi.
# Semua key di bawah ini placeholder kosong.

# ==============================================================================
# 1. TELEGRAM BOT & OWNER
# ==============================================================================
TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=

# ==============================================================================
# 2. WHATSAPP (BAILEYS & META CLOUD API)
# ==============================================================================
WHATSAPP_PREFIX=
WHATSAPP_RESPOND_GROUPS=0
WHATSAPP_PHONE_NUMBER=
OWNER_WA_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ==============================================================================
# 3. DATABASE SUPABASE
# ==============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ==============================================================================
# 4. BOT IDENTITY & RUNTIME CONFIG
# ==============================================================================
BOT_NAME=FreeAIBot
BOT_PROFILE=Asisten AI umum berbahasa Indonesia. Cerdas, adaptif, jujur, dan berwawasan luas.
CONNECT_TIMEOUT_MS=8000
REQUEST_TIMEOUT_MS=90000
MAX_OUTPUT_TOKENS=2500
DOWNLOAD_TIMEOUT_MS=25000
CACHE_TTL_MS=3600000

# ==============================================================================
# 5. PROVIDER TIER 1: XKIRO GATEWAY
# ==============================================================================
XKIRO_KEYS=
XKIRO_MODEL_PRIMARY=qwen/qwen3.8-max:free
XKIRO_MODEL_BACKUPS=qwen/qwen3.6-plus:free,deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash,mistralai/codestral-2508,qwen/qwen3-vl-plus:free,qwen/qwen3.7-plus:free,mistralai/mistral-large-2512
DAILY_CAP_XKIRO=1500

# ==============================================================================
# 6. PROVIDER TIER 2: GROQ CLOUD API
# ==============================================================================
GROQ_KEYS=
GROQ_MODEL_PRIMARY=qwen/qwen3.8-27b
GROQ_MODEL_BACKUP=qwen/qwen3.6-27b
DAILY_CAP_GROQ=800

# ==============================================================================
# 7. PROVIDER TIER 3: CLOUDFLARE WORKERS AI
# ==============================================================================
# Format: accountId:token atau token bare (dipisah koma)
CLOUDFLARE_KEYS=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL_PRIMARY=@cf/meta/llama-3.1-70b-instruct
CLOUDFLARE_MODEL_BACKUP=@cf/qwen/qwen2.5-coder-32b-instruct
DAILY_CAP_CLOUDFLARE=120

# ==============================================================================
# 8. PROVIDER TIER 4: GOOGLE GEMINI API
# ==============================================================================
GEMINI_KEYS=
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_BACKUP=gemini-2.5-flash
DAILY_CAP_GEMINI=1400

# ==============================================================================
# 9. PROVIDER TIER 5: OPENROUTER AI
# ==============================================================================
OPENROUTER_KEYS=
OR_MODEL_PRIMARY=nex-agi/nex-n2.5-pro:free
OR_MODEL_MINI=nex-agi/nex-n2.5-mini:free
OR_MODEL_TEXT=nvidia/nemotron-3.5-lightning:free
DAILY_CAP_OPENROUTER=180

# ==============================================================================
# 10. ADMIN AUTH & SECURITY
# ==============================================================================
RESEND_API_KEY=
RESEND_FROM=ChatBot Security <onboarding@resend.dev>
ADMIN_EMAIL=
PIN_SALT=
ADMIN_PIN=
