# JANGAN commit file ini dengan key asli. Salin ke .env lalu isi.
# Semua key di bawah ini placeholder kosong.

# Wajib P0 (Telegram & Owner)
TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=

# Keamanan Webhook & Cron Vercel (Opsional di Local, Sangat Dianjurkan di Vercel)
# Nilai rahasia acak untuk validasi X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Secret untuk otorisasi Vercel Cron jobs
CRON_SECRET=

# Pool key provider (comma-separated, tanpa spasi). Rotasi otomatis, stop saat 429/kuota.
OPENROUTER_KEYS=
GROQ_KEYS=
GEMINI_KEYS=
OLLAMA_KEYS=

# Model override (opsional, default = hasil verifikasi live PRD v0.2)
OR_MODEL_PRIMARY=nex-agi/nex-n2.5-pro:free
OR_MODEL_MINI=nex-agi/nex-n2.5-mini:free
OR_MODEL_TEXT=nvidia/nemotron-3.5-lightning:free
GROQ_MODEL_PRIMARY=qwen/qwen3.8-27b
GROQ_MODEL_BACKUP=qwen/qwen3.6-27b
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_BACKUP=gemini-2.5-flash
OLLAMA_MODEL_PRIMARY=nemotron-3-nano:30b
OLLAMA_MODEL_BACKUP=gpt-oss:20b

# Database Supabase (Untuk memori percakapan, ringkasan, koreksi, & reminder persisten)
SUPABASE_URL=
# Service key WAJIB di server-side agar RLS mengizinkan operasi internal bot
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Persona & Identitas Bot
BOT_NAME=FreeAIBot
BOT_PROFILE=Asisten AI umum berbahasa Indonesia. Cerdas, adaptif, jujur, dan berwawasan luas.

# Penyetelan Performa & Kecerdasan Dua-Tingkat
# Waktu tunggu respon koneksi/header (jika 429/mati langsung failover cepat ke provider lain)
CONNECT_TIMEOUT_MS=8000
# Waktu tunggu model berpikir mendalam & menyelesaikan generasi teks
REQUEST_TIMEOUT_MS=90000
# Batas token generasi output (ditingkatkan agar mampu koding & penjelasan detail)
MAX_OUTPUT_TOKENS=2500
DOWNLOAD_TIMEOUT_MS=25000
CACHE_TTL_MS=3600000

# Batas Kuota Harian per Provider
DAILY_CAP_OPENROUTER=180
DAILY_CAP_GROQ=800
DAILY_CAP_GEMINI=1400
DAILY_CAP_OLLAMA=500

# Konfigurasi WhatsApp Baileys (Opsional)
# Jika diset, bot hanya merespons pesan yang diawali prefix ini (misal: !ai atau .tanya). Kosongkan untuk merespons semua pesan.
WHATSAPP_PREFIX=
# Set 1 atau true jika bot diizinkan membalas obrolan di dalam grup WhatsApp
WHATSAPP_RESPOND_GROUPS=0
# Nomor telepon bot (format internasional tanpa +, misal: 6283874640066) untuk pairing code otomatis tanpa scan QR
WHATSAPP_PHONE_NUMBER=
