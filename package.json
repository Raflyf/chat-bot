    "dotenv": "^16.4.5",
    "mammoth": "^1.12.2",
    "node-telegram-bot-api": "^0.66.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/node-telegram-bot-api": "^0.64.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@vercel/node": "^12.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
