{
  "version": 2,
  "cleanUrls": true,
  "outputDirectory": "public",
  "functions": {
    "api/webhook.ts": {
      "maxDuration": 60
    },
    "api/whatsapp.ts": {
      "maxDuration": 60
    },
    "api/cron/reminders.ts": {
      "maxDuration": 30
    },
    "api/stats.ts": {
      "maxDuration": 15
    },
    "api/dataset.ts": {
      "maxDuration": 20
    },
    "api/admin-otp.ts": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
